# Nuvio Subtitles add-on — environment configuration template.
#
# Copy to `.env` and fill in the credentials you actually have.
# NEVER commit a filled-in `.env` — it is gitignored on purpose.
# Empty values mean "not configured": the provider is then skipped at runtime.

# --- HTTP server ------------------------------------------------------------
# Port the add-on listens on locally.
PORT=3000

# --- Language preference (ISO 639-1, comma separated) -----------------------
# Arabic by default; any number of languages, first one is the strongest preference.
LANGUAGES=ar

# --- Provider 1: OpenSubtitles (https://www.opensubtitles.com) --------------
# Free API key from the OpenSubtitles developers console. Required for the
# official REST API — the provider is skipped when this is empty.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_ENABLED=true

# --- Provider 2: SubDL (https://subdl.com) ----------------------------------
# Free API key. Required — the provider is skipped when this is empty.
SUBDL_API_KEY=
SUBDL_ENABLED=true

# --- Provider 3: bundled demo fixtures (no credentials, no network) ---------
# Serves recorded, real-shaped payloads so the add-on works out of the box.
DEMOFIXTURES_ENABLED=true

# --- Behaviour --------------------------------------------------------------
# Max subtitles returned per request (per language ordering applied after).
MAX_SUBTITLES=20
# Per-provider timeout in milliseconds — a hanging provider must not hang the request.
PROVIDER_TIMEOUT_MS=8000
# Seconds; mirrors the SDK's cache response properties.
CACHE_MAX_AGE=3600
STALE_REVALIDATE=86400
STALE_ERROR=86400
# JSON object: per-provider enable overrides, e.g. {"subdl":false}
PER_PROVIDER_SETTINGS={}
# Comma separated provider ids controlling result ordering, e.g. opensubtitles,subdl,demoFixtures
PROVIDER_ORDER=

# Advanced: full manifest.config payload as JSON (overrides the env vars above).
# CONFIG_JSON=
